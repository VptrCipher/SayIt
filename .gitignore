# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.dist-info/
.pytest_cache/

# Briefcase build cache / generated metadata
.briefcase/

# Build / release artifacts (distributed as GitHub Release assets, not committed)
installer-output/
*.exe
*.AppImage
*.msi
*.sha256

# Virtual environments
.venv

# Logs (runtime launch logs, etc.)
*.log

# Editor / tooling workspace
.kiro/

# Internal research evidence, phase reports, and generated benchmark data.
